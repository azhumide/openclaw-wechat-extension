{
  // OpenClaw 要连接的 OpenClawBridge 服务端地址
  // 同机部署一般用 127.0.0.1
  // 跨机器/局域网部署时写 aibot 所在机器的 IP
  "wsHost": "127.0.0.1",

  // OpenClawBridge 服务端端口
  // 需要和 aibot/plugins/OpenClawBridge/config.toml 里的 ws_port 一致
  "wsPort": 9093,

  // OpenClawBridge 的 WebSocket 路径
  // 需要和 aibot/plugins/OpenClawBridge/config.toml 里的 ws_path 一致
  "wsPath": "/ws",

  // 兼容字段。当前单端口直连模式下通常保持和 wsHost 一致即可
  "bridgeDownloadHost": "127.0.0.1",

  // 兼容字段。当前单端口直连模式下通常留空即可
  "bridgeDownloadBaseUrl": "",

  // OpenClaw Workspace 根目录
  // 建议显式填写，避免不同环境自动推断出错
  // Linux 例子:
  // "/home/rs/.openclaw/workspace"
  // Windows 例子:
  // "C:/Users/你的用户名/.openclaw/workspace"
  "workspaceBase": "/home/rs/.openclaw/workspace",

  // 可选：临时文件目录
  // 扩展下载/中转媒体时优先使用这个目录
  // 留空则默认使用 workspaceBase/downloads
  "tmpDir": "",

  // 可选：附加媒体搜索目录
  // 当工具返回的是相对路径，扩展会在这些目录里继续查找文件
  // 例子:
  // ["/tmp/openclaw", "/data/shared_media"]
  "mediaSearchPaths": [],

  // 是否在发给 OpenClawBridge 的文本中自动脱敏 wxid / 自定义微信号
  // 推荐开启，避免模型回复里直接带出联系人标识
  "redactWxidsInOutboundText": true,

  // 是否在 WeChat 扩展自己的日志里自动脱敏 wxid / 自定义微信号
  // 推荐开启，避免日志里泄露敏感 ID
  "redactWxidsInLogs": true,

  // 可选：额外需要“精确匹配脱敏”的自定义微信号
  // 用于处理没有 wxid_ 前缀的账号，例如自定义号 / 别名型账号
  // 只做精确匹配，不会模糊匹配普通英文单词
  // 例子:
  // ["xdoufux", "azhumide"]
  "redactExtraWxids": [],

  // 非主人微信发送者调用敏感工具时的策略
  // 可选:
  // "off"     不额外拦截
  // "deny"    直接拒绝
  // "approve" 先走 OpenClaw 插件审批，再继续执行
  "nonOwnerToolAuthMode": "deny",

  // 需要受上面策略保护的工具名
  // 默认建议先保护 exec 和 process
  "nonOwnerToolAuthTools": ["exec", "process"],

  // 可选：工具权限白名单
  // 支持 sender wxid，也支持私聊场景下 OpenClawBridge 传过来的 alias
  // 这些值会和主人一样，跳过上面敏感工具的拒绝/审批逻辑
  // 例子:
  // ["wxid_xxx", "zhangsan_alias"]
  "toolAuthBypassWxids": [],

  // 可选：按工具分别配置白名单
  // key 是工具名，value 是该工具允许跳过拒绝/审批的 wxid 或私聊 alias 列表
  // 这个配置会和上面的全局白名单一起生效
  // 例子:
  // {
  //   "process": ["wxid_xxx", "lisi_alias"],
  //   "exec": ["wxid_owner2"]
  // }
  "toolAuthBypassByTool": {},

  // 可选：skill 黑名单
  // 命中这些 skillId 的普通用户会被拦截，主人和上面的 wxid 白名单不受影响
  // 例子:
  // ["gog", "spotify-player"]
  "toolAuthBlockedSkills": [],

  // 是否允许“已安装 skill”触发的敏感工具直接放行
  // 目前会识别常见的 skill wrapper / skill 目录脚本调用
  // 以及这些 skill exec 启动后对应的 process 会话
  "toolAuthAllowInstalledSkills": false,

  // 是否输出“已安装 skill 自动放行”调试日志
  // 打开后，当某条 exec/process 没被识别成 skill 放行时
  // 日志里会额外显示失败原因，方便排查
  "toolAuthDebugInstalledSkills": false,

  // 主人调用 exec 时，是否在微信侧先把 ask 强制改成 off
  // 这是“尽量不弹审批”的最佳努力开关
  // 注意:
  // 如果主机上的 ~/.openclaw/exec-approvals.json 更严格，它仍然会继续生效
  "ownerExecBypassApproval": false,

  // 非主人直接被拒绝时，是否回一条微信提示
  "toolAuthNotifyBlocked": true,

  // 进入审批队列时，是否回一条“已提交审批”
  "toolAuthNotifyApprovalQueued": true,

  // 审批结束后，是否回一条结果提示
  "toolAuthNotifyApprovalResolved": true,

  // 群聊里是否允许发送上面的工具权限提示
  "toolAuthNotifyInGroup": true,

  // 私聊里是否允许发送上面的工具权限提示
  "toolAuthNotifyInDirect": true,

  // 可选：自定义工具权限提示文案模板
  // 可用占位符:
  // {{toolName}} {{state}} {{stateLabel}} {{senderId}} {{senderName}} {{skillId}}
  // {{from}} {{chatType}} {{chatTypeLabel}} {{conversationLabel}} {{question}}
  // 留空则使用内置默认文案
  "toolAuthMessageBlocked": "",
  "toolAuthMessageQueued": "",
  "toolAuthMessageAllowOnce": "",
  "toolAuthMessageAllowAlways": "",
  "toolAuthMessageDeny": "",
  "toolAuthMessageTimeout": "",
  "toolAuthMessageCancelled": ""
}
